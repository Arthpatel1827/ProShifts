# Settings for `docker compose` (copy to .env next to docker-compose.yml).
# Never commit the real .env.

# ── Addresses ────────────────────────────────────────────────────────────────
# Production: real hostnames pointing at this server. Caddy fetches HTTPS
# certificates for them automatically (ports 80 and 443 must be reachable).
#   WEB_ADDRESS=app.example.com
#   API_ADDRESS=api.example.com
#   WEB_ORIGIN=https://app.example.com
#
# Local trial over plain HTTP (web on http://localhost, API on http://localhost:8080):
WEB_ADDRESS=:80
API_ADDRESS=:8080
WEB_ORIGIN=http://localhost
# Only for that plain-HTTP trial — leave unset (true) whenever HTTPS is used.
COOKIE_SECURE=false

# ── Secrets (required) ───────────────────────────────────────────────────────
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
POSTGRES_USER=myschedule
POSTGRES_DB=myschedule
ANTHROPIC_API_KEY=

EMAIL_SENDING_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
