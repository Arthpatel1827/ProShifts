# Copy to backend/.env and fill in real values. Never commit backend/.env.
FLASK_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myschedule

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ chars) when FLASK_ENV=production — the app refuses to start otherwise.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI (NVIDIA Nemotron). Get a key at https://build.nvidia.com — server-side only.
# Without a key the app runs normally and AI features report that AI isn't configured.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_NEMOTRON_REASONING=false
# Weekly hours after which overtime applies (set for your jurisdiction).
OVERTIME_WEEKLY_HOURS=40

# Email transport (set EMAIL_SENDING_ENABLED=true to actually send)
EMAIL_SENDING_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Comma-separated web origins allowed to call the API and open sockets.
# Must not be "*" in production. Native mobile clients are allowed regardless.
CORS_ORIGINS=http://localhost:3000
