# Copy to .env.local for local development without Docker.
# Server-side only: where the Next.js proxy reaches Flask.
FLASK_API_URL=http://localhost:5000
# Browser-side Socket.IO endpoint. Leave unset behind the reverse proxy (Docker), where
# sockets share the app's origin; set it for local dev where Flask runs on another port.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Session cookies are Secure in production. Only for a plain-HTTP trial run:
# COOKIE_SECURE=false
